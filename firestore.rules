rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidConversionJob(data) {
      return data.keys().hasAll(['ownerId', 'originalName', 'targetFormat', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             data.ownerId == request.auth.uid &&
             data.originalName is string && data.originalName.size() <= 500 &&
             data.targetFormat is string && data.targetFormat.size() <= 20 &&
             data.status in ['pending', 'processing', 'completed', 'failed'] &&
             data.get('storagePath', '') is string && data.get('storagePath', '').size() <= 1000;
    }

    match /conversionJobs/{jobId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidId(jobId) &&
                    isValidConversionJob(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() && 
                    isValidId(jobId) &&
                    isValidConversionJob(incoming()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    (
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'storagePath']))
                    );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
