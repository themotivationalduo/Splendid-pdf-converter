{
  "entities": {
    "ConversionJob": {
      "title": "Conversion Job",
      "description": "Tracks file conversion tasks and their associated Firebase Storage locations.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string"
        },
        "originalName": {
          "type": "string"
        },
        "targetFormat": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "completed", "failed"]
        },
        "storagePath": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "originalName",
        "targetFormat",
        "status"
      ]
    },
    "UserLimit": {
      "title": "User Limit",
      "description": "Tracks daily conversion usage limits per user to control ConvertAPI premium costs.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "conversionsCount": {
          "type": "integer"
        },
        "lastReset": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "conversionsCount",
        "lastReset",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/conversionJobs/{jobId}": {
      "schema": {
        "$ref": "#/entities/ConversionJob"
      },
      "description": "Stores references to files uploaded for conversion."
    },
    "/userLimits/{userId}": {
      "schema": {
        "$ref": "#/entities/UserLimit"
      },
      "description": "Stores daily usage limits and conversion counters for each user."
    }
  }
}
